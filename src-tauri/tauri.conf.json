{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Song Analyzer Tagger",
  "version": "0.1.0",
  "identifier": "io.github.song-analyzer-tagger",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Song Analyzer · Genre Tagger", "width": 1500, "height": 950, "minWidth": 1000, "minHeight": 640, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["models/*"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "both", "languages": ["Greek", "English"], "displayLanguageSelector": true }
    }
  }
}
